{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/a2a/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 300 }
  }
}
