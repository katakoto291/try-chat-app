{
  "name": "agent-sample-trip-planner",
  "version": "0.1.0",
  "private": true,
  "description": "MCP サーバーのツールを使う観光プランナー（Strands Agents TypeScript 版）",
  "type": "module",
  "scripts": {
    "ask": "tsx --env-file-if-exists=.env src/cli.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-providers": "^3.1161.0",
    "@azure/identity": "^4.14.1",
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/client": "^2.4.0",
    "@smithy/signature-v4": "^5.7.5",
    "@strands-agents/sdk": "^1.23.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7",
    "@a2a-js/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@a2a-js/sdk": "$@a2a-js/sdk"
  }
}
