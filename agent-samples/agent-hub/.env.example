# 起動時に登録するエージェント（カンマ区切り）。
# ふつうの HTTP のエージェントはベース URL、AgentCore Runtime のエージェントは ARN を書く
HUB_AGENTS=http://localhost:8080,http://localhost:8081

# ハブの合言葉。設定すると Authorization: Bearer <HUB_TOKEN> が必要になる（/ping 以外）
# ハブを通せば登録された全エージェントを呼べるので、ローカル以外に置くときは必ず設定する
HUB_TOKEN=

# AgentCore のエージェントを登録するときは、ハブが AWS の認証情報で署名して呼ぶ
# （aws configure / AWS_PROFILE / 実行ロールなどから自動で読みます）

PORT=8090
