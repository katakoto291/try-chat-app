# どこの Claude を使うか: anthropic | bedrock | foundry
MODEL_PROVIDER=anthropic

# モデル ID（省略時の既定値はプロバイダごとに src/model.ts を参照）
#   anthropic: claude-opus-5-5
#   bedrock  : us.anthropic.claude-opus-5-5（推論プロファイル ID。リージョンに合わせて us./eu./apac./global.）
#   foundry  : Foundry で作った「デプロイ名」
# 料金を抑えたいときは claude-sonnet-5-5 / claude-haiku-5-5 なども指定できます
MODEL_ID=

# --- anthropic のとき ---
ANTHROPIC_API_KEY=

# --- bedrock のとき（AWS の認証情報は aws configure / AWS_PROFILE / 実行ロールなどから自動で読みます）---
AWS_REGION=us-east-1

# --- foundry のとき ---
# リソース名（https://<ここ>.services.ai.azure.com）
ANTHROPIC_FOUNDRY_RESOURCE=
# API キー。空なら Entra ID（az login / マネージド ID）で認証します
ANTHROPIC_FOUNDRY_API_KEY=

# 待ち受けポート（AgentCore は 8080、Foundry は 8088）
PORT=8080
