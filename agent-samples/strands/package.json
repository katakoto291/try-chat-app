{
  "name": "agent-sample-strands",
  "version": "0.1.0",
  "private": true,
  "description": "Strands Agents（TypeScript 版）で作ったエージェント（AgentCore / Foundry どちらでも動く HTTP サーバー付き）",
  "type": "module",
  "scripts": {
    "ask": "tsx --env-file-if-exists=.env src/cli.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@anthropic-ai/sdk": "^0.109.1",
    "@azure/identity": "^4.14.1",
    "@hono/node-server": "^2.1.6",
    "@strands-agents/sdk": "^1.23.0",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@a2a-js/sdk": "$@a2a-js/sdk"
  }
}
