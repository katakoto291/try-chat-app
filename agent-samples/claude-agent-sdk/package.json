{
  "name": "agent-sample-claude-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Agent SDK で作ったエージェント（AgentCore / Foundry どちらでも動く HTTP サーバー付き）",
  "type": "module",
  "scripts": {
    "ask": "tsx --env-file-if-exists=.env src/cli.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@a2a-js/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
