# どこの Claude を使うか: anthropic | bedrock | foundry
MODEL_PROVIDER=anthropic

# モデル ID（省略時: anthropic/foundry は claude-opus-5-5、bedrock は us.anthropic.claude-opus-5-5）
# foundry では Foundry で作った「デプロイ名」を入れます
MODEL_ID=

# --- anthropic のとき ---
ANTHROPIC_API_KEY=

# --- bedrock のとき（AWS の認証情報は aws configure / AWS_PROFILE / 実行ロールなどから自動で読みます）---
AWS_REGION=us-east-1

# --- foundry のとき ---
ANTHROPIC_FOUNDRY_RESOURCE=
# 空なら Entra ID（az login / マネージド ID）で認証します
ANTHROPIC_FOUNDRY_API_KEY=

# 待ち受けポート（AgentCore は 8080、Foundry は 8088）
PORT=8080
