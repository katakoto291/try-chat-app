# Claude API キー。未設定なら「モックモード」（API を呼ばずに動作を模擬）で起動します。
ANTHROPIC_API_KEY=

# mock | anthropic （未指定なら API キーの有無で自動判定）
LLM_MODE=

# 使用モデル（省略時は 司令塔: claude-sonnet-5 / サブエージェント: claude-haiku-4-5）
# 例: 全部 claude-haiku-4-5 にするといちばん安い。claude-opus-5 にすると高品質だが高い
ORCHESTRATOR_MODEL=
SUBAGENT_MODEL=

PORT=3000

# 合言葉ログイン。設定すると、合言葉を知っている人だけが使える（公開するときは必須）
APP_PASSWORD=

# Agent Card などに載せる、このサーバー自身の URL（省略時はアクセスされた URL から自動で決まる）
# SELF_URL=https://your-app.vercel.app

# ───── 外部エージェント（agent-samples/ のエージェントなど、別のサーバーで動くもの） ─────
# 「呼び出し」パターンのとき、司令塔が call_ext_* ツールで呼べるようになります。
# (1) URL を直接並べる（カンマ区切り。各エージェントの自己紹介を読みに行く）
# EXTERNAL_AGENTS=http://localhost:8080,http://localhost:8081
# (2) agent-hub を使う（こちらが優先）。一覧も呼び出しもハブ経由になる
# AGENT_HUB_URL=http://localhost:8090
# AGENT_HUB_TOKEN=
